# Application config. Copy to backend/.env, or better: let `docker compose run --rm --no-deps setup`
# generate it with random credentials.
#
# NOTE: docker compose does NOT read this file for the database or cache passwords.
# Compose reads the repo-root .env for ${VAR} interpolation. app.setup writes both.
# See .env.compose.example for the compose-side variables.

# Database — app.setup generates a random password. Do not ship 'firemaster'.
POSTGRES_USER=firemaster
POSTGRES_PASSWORD=change-me-app-setup-generates-a-random-one
POSTGRES_DB=firemaster
DATABASE_URL=postgresql+asyncpg://firemaster:change-me-app-setup-generates-a-random-one@localhost:5432/firemaster
DATABASE_URL_SYNC=postgresql://firemaster:change-me-app-setup-generates-a-random-one@localhost:5432/firemaster

# Redis
REDIS_URL=redis://:change-me-must-match-REDIS_PASSWORD@localhost:6379/0

# Auth — app.setup generates these. Do not commit real values.
JWT_SECRET_KEY=change-me-to-a-random-32-byte-hex-string
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=change-me-to-bcrypt-hash

# CORS (comma-separated origins, default localhost dev server)
CORS_ORIGINS=http://localhost:5173

# Monarch Money
MONARCH_SESSION_FILE=.monarch_session

# Anthropic (optional — only needed for in-app AI advisor, not Claude Code)
ANTHROPIC_API_KEY=

# App
APP_ENV=development
# Log every SQL statement to the console (debugging only — very noisy)
DATABASE_ECHO=false
