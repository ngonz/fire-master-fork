# Repo-root .env — read by `docker compose` for ${VAR} interpolation ONLY.
# This is a different file from backend/.env, which the application itself reads.
#
# docker-compose.yml deliberately has no top-level env_file: compose interpolates env_file
# values, which mangles the "$" characters in the bcrypt AUTH_PASSWORD_HASH and breaks login.
# So backend/.env is bind-mounted and read directly by pydantic, and anything the *containers*
# need for their own startup (postgres, redis) has to be here instead.
#
# `docker compose run --rm backend uv run python -m app.setup` creates this for you with
# random passwords. Copy this file manually only if you want to set the values yourself.

# Interface the published ports bind to. 127.0.0.1 means "this machine only", which is the
# right default for a personal finance app holding a full Monarch transaction history.
# Setting 0.0.0.0 exposes postgres, redis, the API and the UI to everyone on your network.
BIND_HOST=127.0.0.1

# Database credentials. Must be non-empty; the compose files fall back to an obvious
# CHANGEME placeholder so an unconfigured stack is loud rather than quietly weak.
#
# WARNING: postgres only reads POSTGRES_PASSWORD when initialising an empty data directory.
# Changing it later against an existing pgdata volume leaves the old password in place and
# every connection fails. Either `docker compose down -v` (destroys the database) or use
# ALTER USER inside psql.
POSTGRES_USER=firemaster
POSTGRES_PASSWORD=change-me-use-a-long-random-string
POSTGRES_DB=firemaster

# Redis password. Redis has no auth at all unless requirepass is set, so anything that can
# reach the port can read cached data and inject Celery jobs.
REDIS_PASSWORD=change-me-use-a-long-random-string

# Images. Default to locally built tags so `docker compose up --build` runs the code in this
# checkout — including any local security fixes. Point at a registry to pull prebuilt images
# instead, but note that a :latest tag is mutable and will not contain your local changes.
# FIREMASTER_BACKEND_IMAGE=firemaster-backend:local
# FIREMASTER_FRONTEND_IMAGE=firemaster-frontend:local

# Host port overrides (the container-side ports never change).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
